/* sock.pli - POSIX (Linux/macOS) socket compatibility layer (PL/I implementation).
 *
 * Module:  sock
 * Purpose: Implement sock_* procedures as thin PL/I wrappers over the raw
 *          libc system calls invoked directly via external() FFI.  No C
 *          source is compiled on POSIX; the external() entries bind to libc
 *          symbols (socket, close, bind, ...) at executable link time.
 *
 * Error handling: sock_* procedures return raw values (0 on success,
 * -1 on error) and let libc set errno.  Condition raising is the
 * responsibility of the net layer (source/net.pli).
 */

 sock: package exports(new_socket, sock_close, sock_shutdown, sock_bind,
     sock_listen, sock_accept, sock_connect, sock_send, sock_recv,
     sock_sendto, sock_recvfrom, sock_setsockopt, sock_getsockopt,
     sock_getpeername, sock_getsockname, sock_setnonblock, sock_poll,
     sock_poll_multi, sock_getaddrinfo, sock_freeaddrinfo, sock_errno);

 /*--- struct sizes ---*/
%replace ADDRINFO_SIZE by 48;  /* struct addrinfo size, 64-bit */
%replace POLLFD_BUF_SIZE by 8192;   /* NET_MAX_CLIENTS(1024) * 8 */
%replace HOST_BUF_SIZE by 257;       /* NET_HOST_MAX(256) + 1 */
%include type_defs;
%include errno;
%include sock_common;

/*--- struct layouts for PL/I-side construction/parsing ---*/

/* struct pollfd (8 bytes on 64-bit):
 *   fd:     int32  offset 0
 *   events: int16  offset 4
 *   revents:int16  offset 6 */
dcl 1 pollfd_t unaligned,
    2 pfd_fd     fixed bin(31),
    2 pfd_events fixed bin(15),
    2 pfd_revents fixed bin(15);

/*--- raw libc bindings (direct FFI, no C bridge) ---*/

dcl c_socket entry (fixed bin(31), fixed bin(31), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('socket');

dcl c_close entry (fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('close');

dcl c_shutdown entry (fixed bin(31), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('shutdown');

dcl c_bind entry (fixed bin(31), char(*), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('bind');

dcl c_listen entry (fixed bin(31), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('listen');

dcl c_accept entry (fixed bin(31), pointer, pointer)
     returns (fixed bin(31))
     options (linkage(system)) external ('accept');

dcl c_connect entry (fixed bin(31), char(*), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('connect');

dcl c_send entry (fixed bin(31), char(*), fixed bin(31),
    fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('send');

dcl c_recv entry (fixed bin(31), char(*), fixed bin(31),
    fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('recv');

dcl c_sendto entry (fixed bin(31), char(*), fixed bin(31),
    fixed bin(31), char(*), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('sendto');

dcl c_recvfrom entry (fixed bin(31), char(*), fixed bin(31),
    fixed bin(31), char(*), pointer)
     returns (fixed bin(31))
     options (linkage(system)) external ('recvfrom');

dcl c_setsockopt entry (fixed bin(31), fixed bin(31), fixed bin(31),
     pointer, fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('setsockopt');

dcl c_getsockopt entry (fixed bin(31), fixed bin(31), fixed bin(31),
     pointer, pointer)
     returns (fixed bin(31))
     options (linkage(system)) external ('getsockopt');

dcl c_getpeername entry (fixed bin(31), char(*), pointer)
     returns (fixed bin(31))
     options (linkage(system)) external ('getpeername');

dcl c_getsockname entry (fixed bin(31), char(*), pointer)
     returns (fixed bin(31))
     options (linkage(system)) external ('getsockname');

dcl c_fcntl entry (fixed bin(31), fixed bin(31), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('fcntl');

dcl c_poll entry (ptr, fixed bin(31), fixed bin(31))
     returns (fixed bin(31))
     options (linkage(system)) external ('poll');

dcl c_getaddrinfo entry (pointer, pointer, pointer, pointer)
     returns (fixed bin(31))
     options (linkage(system)) external ('getaddrinfo');

dcl c_freeaddrinfo entry (pointer)
     options (linkage(system)) external ('freeaddrinfo');

/*--- libc errno accessor ---*/
/* errno is per-thread and not a plain symbol on glibc/Darwin, so go
 * through the platform accessor (__errno_location / __error). */
dcl c_errno_loc entry () returns (pointer)
     options (linkage(system)) external (SOCK_ERRNO_ACCESSOR);

dcl errno_ptr pointer;
dcl 1 errno_view based(errno_ptr) unaligned,
    2 errno_val fixed bin(31);

set_errno: procedure (v);
    dcl v fixed bin(31);
    errno_ptr = c_errno_loc();
    errno_view.errno_val = v;
end set_errno;

sock_errno: procedure () returns (fixed bin(31));
    errno_ptr = c_errno_loc();
    return (errno_view.errno_val);
end sock_errno;

/*--- fcntl constants (POSIX) ---*/
%replace F_GETFL    by  3;
%replace F_SETFL    by  4;

/*--- libc poll(2) event bits ---*/
%replace C_POLLIN   by    1;
%replace C_POLLOUT  by    4;
%replace C_POLLERR  by    8;
%replace C_POLLHUP  by   16;
%replace C_POLLNVAL by   32;

/*===============================================================*/
/* Socket lifecycle (thin pass-throughs to libc)                 */
/*===============================================================*/

 new_socket: procedure (family, type, proto) returns (fixed bin(31));
    dcl family fixed bin(31);
    dcl type   fixed bin(31);
    dcl proto  fixed bin(31);
    return (c_socket(family, type, proto));
 end new_socket;

 sock_close: procedure (fd) returns (fixed bin(31));
   dcl fd fixed bin(31);
   return (c_close(fd));
 end sock_close;

sock_shutdown: procedure (fd, how) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl how fixed bin(31);
    return (c_shutdown(fd, how));
end sock_shutdown;

sock_bind: procedure (fd, addr_buf) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl addr_buf char(*);
    return (c_bind(fd, addr_buf, length(addr_buf)));
end sock_bind;

sock_listen: procedure (fd, backlog) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl backlog fixed bin(31);
    return (c_listen(fd, backlog));
end sock_listen;

/* accept with NULL sockaddr/addrlen (simpler than c_accept). */
sock_accept: procedure (fd) returns (fixed bin(31));
    dcl fd fixed bin(31);
    return (c_accept(fd, null(), null()));
end sock_accept;

/*===============================================================*/
/* Connect / data transfer                                       */
/*===============================================================*/

sock_connect: procedure (fd, addr_buf) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl addr_buf char(*);
    return (c_connect(fd, addr_buf, length(addr_buf)));
end sock_connect;

sock_send: procedure (fd, buf, flags) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl buf char(*);
    dcl flags fixed bin(31);
    return (c_send(fd, buf, length(buf), flags));
end sock_send;

sock_recv: procedure (fd, buf, flags) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl buf char(*);
    dcl flags fixed bin(31);
    return (c_recv(fd, buf, length(buf), flags));
end sock_recv;

sock_sendto: procedure (fd, buf, flags, addr_buf)
    returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl buf char(*);
    dcl flags fixed bin(31);
    dcl addr_buf char(*);
    return (c_sendto(fd, buf, length(buf), flags,
                     addr_buf, length(addr_buf)));
end sock_sendto;

sock_recvfrom: procedure (fd, buf, flags, addr_buf, addrlen_ptr)
    returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl buf char(*);
    dcl flags fixed bin(31);
    dcl addr_buf char(*);
    dcl addrlen_ptr pointer;
    return (c_recvfrom(fd, buf, length(buf), flags, addr_buf,
        addrlen_ptr));
end sock_recvfrom;

/*===============================================================*/
/* Socket options                                                */
/*===============================================================*/

sock_setsockopt: procedure (fd, level, optname, value_ptr)
    returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl level fixed bin(31);
    dcl optname fixed bin(31);
    dcl value_ptr char(*);
    return (c_setsockopt(fd, level, optname, addr(value_ptr),
        length(value_ptr)));
end sock_setsockopt;

sock_getsockopt: procedure (fd, level, optname, value_ptr, optlen_ptr)
    returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl level fixed bin(31);
    dcl optname fixed bin(31);
    dcl value_ptr pointer;
    dcl optlen_ptr pointer;
    return (c_getsockopt(fd, level, optname, value_ptr, optlen_ptr));
end sock_getsockopt;

/*===============================================================*/
/* Address queries                                               */
/*===============================================================*/

sock_getpeername: procedure (fd, addr_buf, addrlen_ptr)
    returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl addr_buf char(*);
    dcl addrlen_ptr pointer;
    return (c_getpeername(fd, addr_buf, addrlen_ptr));
end sock_getpeername;

sock_getsockname: procedure (fd, addr_buf, addrlen_ptr)
    returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl addr_buf char(*);
    dcl addrlen_ptr pointer;
    return (c_getsockname(fd, addr_buf, addrlen_ptr));
end sock_getsockname;

/*===============================================================*/
/* Nonblocking I/O                                               */
/*===============================================================*/

/* Set or clear O_NONBLOCK via fcntl(F_GETFL/F_SETFL).
 * Bitwise OR/AND performed on BIT(32) since PL/I lacks IOR/IAND
 * on FIXED BINARY. */
sock_setnonblock: procedure (fd, on) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl on fixed bin(31);
    dcl new_fl fixed bin(31);
    dcl pfb pointer;
    dcl fl_buf char(4) based(pfb);
    dcl 1 flag_view based(pfb) unaligned,
        2 flag_word fixed bin(31),
        2 flag_bits bit(32);
    dcl ob_set bit(32) init('00000000000000000000000000000100'b);
    dcl ob_clr bit(32) init('11111111111111111111111111111011'b);

    pfb = addr(fl_buf);

    /* Get current flags */
    flag_view.flag_word = c_fcntl(fd, F_GETFL, 0);
    if flag_view.flag_word < 0 then return (-1);

    /* O_NONBLOCK bit pattern: 4 = 00000000000000000000000000000100 */
    if on then do;
        flag_view.flag_bits = flag_view.flag_bits | ob_set;
    end;
    else do;
        flag_view.flag_bits = flag_view.flag_bits & ob_clr;
    end;

    new_fl = flag_view.flag_word;
    return (c_fcntl(fd, F_SETFL, new_fl));
end sock_setnonblock;

/*===============================================================*/
/* poll(2) - single and multi-fd                                 */
/*===============================================================*/

/* Translate libnet poll mask (POLLIN=1, POLLOUT=2) to libc poll
 * bits (C_POLLIN=1, C_POLLOUT=4), call poll, return the count of
 * ready fds (0 = timeout, -1 = error).  revents are not
 * translated for the single-fd variant. */
sock_poll: procedure (fd, events, ms) returns (fixed bin(31));
    dcl fd fixed bin(31);
    dcl events fixed bin(31);
    dcl ms fixed bin(31);
    dcl pfd_buf char(8);
    dcl pfb pointer;
    dcl 1 pfd based(pfb) unaligned,
        2 pfd_fd   fixed bin(31),
        2 pfd_events fixed bin(15),
        2 pfd_revents fixed bin(15);
    dcl c_events fixed bin(31);

    pfd_buf = low(8);
    pfb = addr(pfd_buf);
    pfd.pfd_fd = fd;

    c_events = 0;
    if mod(events, 2) ^= 0 then c_events = c_events + C_POLLIN;
    if mod(events / 2, 2) ^= 0 then c_events = c_events + C_POLLOUT;
    pfd.pfd_events = c_events;

    return (c_poll(pfb, 1, ms));
end sock_poll;

/* Multi-fd poll across an array of fds.
 * fds_ptr/events_ptr/revents_ptr point to arrays of fixed bin(31)
 * of length nfds.  libnet event masks are translated to libc bits
 * for input, and libc revents are translated back to libnet masks
 * for output.  Returns the count of ready fds (0 = timeout,
 * -1 = error). */
sock_poll_multi: procedure (fds_ptr, events_ptr, revents_ptr,
    nfds, ms) returns (fixed bin(31));
    dcl fds_ptr pointer;
    dcl events_ptr pointer;
    dcl revents_ptr pointer;
    dcl nfds fixed bin(31);
    dcl ms fixed bin(31);
    dcl pf_buf char(POLLFD_BUF_SIZE);
    dcl pfb pointer;
    dcl 1 pfd_arr (NET_MAX_CLIENTS) based(pfb) unaligned,
        2 pfd_fd     fixed bin(31),
        2 pfd_events fixed bin(15),
        2 pfd_revents fixed bin(15);
    dcl 1 fd_arr based(fds_ptr) unaligned,
        2 fd_val (NET_MAX_CLIENTS) fixed bin(31);
    dcl 1 ev_arr based(events_ptr) unaligned,
        2 ev_val (NET_MAX_CLIENTS) fixed bin(31);
    dcl 1 rv_arr based(revents_ptr) unaligned,
        2 rv_val (NET_MAX_CLIENTS) fixed bin(31);
    dcl i fixed bin(31);
    dcl c_events fixed bin(31);
    dcl c_revents fixed bin(31);
    dcl ready fixed bin(31);

    pfb = addr(pf_buf);
    pf_buf = low(POLLFD_BUF_SIZE);

    do i = 1 to nfds;
        pfd_arr(i).pfd_fd = fd_arr.fd_val(i);
        c_events = 0;
        if mod(ev_arr.ev_val(i), 2) ^= 0 then
            c_events = c_events + C_POLLIN;
        if mod(ev_arr.ev_val(i) / 2, 2) ^= 0 then
            c_events = c_events + C_POLLOUT;
        pfd_arr(i).pfd_events = c_events;
        pfd_arr(i).pfd_revents = 0;
    end;

    ready = c_poll(pfb, nfds, ms);
    if ready < 0 then return (-1);

    ready = 0;
    do i = 1 to nfds;
        c_revents = pfd_arr(i).pfd_revents;
        rv_arr.rv_val(i) = 0;
        if mod(c_revents, 2) ^= 0 then
            rv_arr.rv_val(i) = rv_arr.rv_val(i) + POLLIN;
        if mod(c_revents / 4, 2) ^= 0 then
            rv_arr.rv_val(i) = rv_arr.rv_val(i) + POLLOUT;
        if mod(c_revents / 8, 2) ^= 0 |
           mod(c_revents / 16, 2) ^= 0 |
           mod(c_revents / 32, 2) ^= 0 then
            rv_arr.rv_val(i) = rv_arr.rv_val(i) + 4;
        if rv_arr.rv_val(i) ^= 0 then ready = ready + 1;
    end;

    return (ready);
end sock_poll_multi;

/*===============================================================*/
/* DNS - getaddrinfo                                             */
/*===============================================================*/

sock_getaddrinfo: procedure (host, port, addr_buf)
    returns (fixed bin(31));
    dcl host char(*);
    dcl port fixed bin(31);
    dcl addr_buf char(*);
    dcl host_buf char(HOST_BUF_SIZE);
    dcl hints_buf char(ADDRINFO_SIZE);
    dcl ph pointer;
    dcl 1 hints based(ph) unaligned,
        2 ai_flags   fixed bin(31),
        2 ai_family  fixed bin(31),
        2 ai_socktype fixed bin(31),
        2 ai_protocol fixed bin(31),
        2 ai_addrlen fixed bin(63),
        2 ai_canonname pointer,
        2 ai_addr    pointer,
        2 ai_next    pointer;
    dcl res_ptr pointer;
    dcl gai fixed bin(31);
    dcl i fixed bin(31);
    dcl n fixed bin(31);
    dcl p pointer;
%if addrinfo_addr_before_canon = 1 %then
    dcl 1 res_view based(res_ptr) unaligned,
        2 rai_flags   fixed bin(31),
        2 rai_family  fixed bin(31),
        2 rai_socktype fixed bin(31),
        2 rai_protocol fixed bin(31),
        2 rai_addrlen fixed bin(63),
        2 rai_addr    pointer,
        2 rai_canonname pointer,
        2 rai_next    pointer;
%else
    dcl 1 res_view based(res_ptr) unaligned,
        2 rai_flags   fixed bin(31),
        2 rai_family  fixed bin(31),
        2 rai_socktype fixed bin(31),
        2 rai_protocol fixed bin(31),
        2 rai_addrlen fixed bin(63),
        2 rai_canonname pointer,
        2 rai_addr    pointer,
        2 rai_next    pointer;
    dcl src_buf char(SOCKADDR_IN_SIZE) based(p);
    dcl port_hi fixed bin(31);
    dcl port_lo fixed bin(31);
    dcl header fixed bin(63);

    /* NUL-terminate host in host_buf (getaddrinfo needs C string). */
    host_buf = low(HOST_BUF_SIZE);
    n = length(host);
    if n > NET_HOST_MAX then n = NET_HOST_MAX;
    do i = 1 to n;
        substr(host_buf, i, 1) = substr(host, i, 1);
    end;

    /* Zero hints and set AF_INET / SOCK_STREAM. */
    hints_buf = low(ADDRINFO_SIZE);
    ph = addr(hints_buf);
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;

    gai = c_getaddrinfo(addr(host_buf), null(), ph, addr(res_ptr));
    if gai ^= 0 then do;
        /* Map EAI_* to errno. */
        if gai = EAI_MEMORY then call set_errno(ENOMEM);
        else if gai = EAI_NONAME then call set_errno(ENOENT);
        else call set_errno(EINVAL);
        return (-1);
    end;

    if res_ptr = null() then do;
        call set_errno(ENOENT);
        call c_freeaddrinfo(res_ptr);
        return (-1);
    end;

    /* Copy 16 bytes of sockaddr_in from ai_addr to addr_buf. */
    p = res_view.rai_addr;
    addr_buf = src_buf;

    /* Overwrite sin_family/sin_port.  Darwin's sockaddr_in has a
     * leading sin_len byte; Linux starts directly with sin_family.
     * The port is big-endian in both layouts. */
    port_hi = mod(port / 256, 256);
    port_lo = mod(port, 256);
    header = AF_INET + port_hi * 65536 + port_lo * 16777216 +
             SOCKADDR_HAS_SIN_LEN * (SOCKADDR_IN_SIZE + AF_INET * 256);
    phdr = addr(addr_buf);
    if header >= 2147483648 then header = header - 4294967296;
    sockaddr_hdr.w0 = header;

    call c_freeaddrinfo(res_ptr);
    return (0);
end sock_getaddrinfo;

sock_freeaddrinfo: procedure (ptr);
    dcl ptr pointer;
    call c_freeaddrinfo(ptr);
end sock_freeaddrinfo;

end sock;
