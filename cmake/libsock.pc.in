prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libsock
Description: PL/I socket compatibility layer (compiled PL/I module)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lsock
Libs.private: @LIBSOCK_PC_PRIVATE@
Cflags: -I${includedir}
